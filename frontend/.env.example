# URL de l'API backend.
# Laissez vide pour utiliser le proxy Vite (dev) : les requêtes /api/* sont
# redirigées vers http://localhost:8080 automatiquement.
VITE_API_URL=

# Auth (Neon Auth — Managed Better Auth)
# URL fournie dans la console Neon (Auth > Configuration).
# Format : https://ep-xxxx.neonauth.us-east-2.aws.neon.build/neondb/auth
VITE_NEON_AUTH_URL=
