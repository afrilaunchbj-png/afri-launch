server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback : toute route non fichier renvoie index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache long pour les assets hashés
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
