# Environnement
APP_ENV=development
PORT=8080

# Base de données
DATABASE_URL=postgres://afrilaunch:afrilaunch@localhost:5432/afrilaunch?sslmode=disable

# Redis (cache + asynq)
REDIS_URL=redis://localhost:6379/0

# Frontend (URL de la SPA, pour les redirects OAuth et CORS)
FRONTEND_URL=http://localhost:5173

# Sécurité / CORS
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Métier
WELCOME_CREDITS=100

# Providers (à remplir pour les intégrations réelles)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
AI_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
