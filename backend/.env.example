# Environnement
APP_ENV=development
PORT=8080

# Base de données (Neon Postgres)
# Utiliser l'endpoint "pooler" (-pooler) pour le serverless.
# Retirer `channel_binding=require` si pgx échoue (SCRAM channel binding).
DATABASE_URL=postgres://afrilaunch:afrilaunch@localhost:5432/afrilaunch?sslmode=disable

# Redis (cache + asynq)
REDIS_URL=redis://localhost:6379/0

# Auth (Neon Auth — Managed Better Auth)
# URL de base fournie dans la console Neon (Auth > Configuration).
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.build/neondb/auth
# Optionnel : JWKS dérivé automatiquement de NEON_AUTH_BASE_URL si vide.
NEON_AUTH_JWKS_URL=

# Sécurité / CORS
ALLOWED_ORIGINS=http://localhost:5173

# Métier
WELCOME_CREDITS=100

# Object Storage (Neon S3) — à utiliser lors de la génération d'assets
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Providers IA / paiements (à venir)
AI_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
