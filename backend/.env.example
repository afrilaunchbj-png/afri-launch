# Environnement
APP_ENV=development
PORT=8080

# Base de données (Neon Postgres)
# Utiliser l'endpoint "pooler" (-pooler) pour le serverless.
# Retirer `channel_binding=require` si pgx échoue (SCRAM channel binding).
DATABASE_URL=postgres://afrilaunch:afrilaunch@localhost:5432/afrilaunch?sslmode=disable

# Redis (cache + asynq)
REDIS_URL=redis://localhost:6379/0

# Auth (Neon Auth — Managed Better Auth)
# URL de base fournie dans la console Neon (Auth > Configuration).
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.us-east-2.aws.neon.build/neondb/auth
# Optionnel : JWKS dérivé automatiquement de NEON_AUTH_BASE_URL si vide.
NEON_AUTH_JWKS_URL=

# Sécurité / CORS
ALLOWED_ORIGINS=http://localhost:5173

# Métier
WELCOME_CREDITS=100

# Object Storage (Neon S3 en prod) — utilisé si S3_BUCKET est défini, sinon disque local (dev)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Adressage par chemin (requis par la plupart des endpoints compatibles S3)
S3_PATH_STYLE=true

# Providers IA — OpenAI (recherche / images / documents)
OPENAI_API_KEY=
OPENAI_MODEL_RESEARCH=gpt-5.6-terra
OPENAI_MODEL_IDEATION=gpt-5.6-luna
OPENAI_MODEL_IMAGE=gpt-image-2

# Providers IA — HeyGen (vidéo avatar)
HEYGEN_API_KEY=
HEYGEN_API_URL=
# Avatar/voix par défaut pour les vidéos publicitaires (catalogue HeyGen)
HEYGEN_DEFAULT_AVATAR_ID=
HEYGEN_DEFAULT_VOICE_ID=

# Rendu HTML → PDF/PPTX (chromedp). Vide = auto-détection du navigateur.
CHROME_PATH=

# Intégrations publicitaires (ADR-017)
# URL publique du frontend (destination des redirections OAuth).
APP_URL=http://localhost:5173
# Clé de chiffrement des tokens OAuth (32+ caractères aléatoires) + version.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=v1

# Meta Ads (developers.facebook.com) — redirect URI à déclarer dans l'app Meta.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0
META_OAUTH_REDIRECT_URI=
# Optionnel (défaut : ads_management,ads_read,business_management,pages_show_list,pages_read_engagement)
META_OAUTH_SCOPES=

# Google Ads (console Google Cloud + Google Ads API) — créatives non supportées au MVP.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_REDIRECT_URI=
# Optionnel : MCC contextuel si les comptes sont gérés par un manager (jamais l'ID client).
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Optionnel (défaut v19).
GOOGLE_ADS_API_VERSION=

# TikTok Ads (business-api.tiktok.com) — créatives non supportées au MVP.
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=

# Paiements (ADR-018) — provider activé via PAYMENT_PROVIDER.
# Valeurs : pawapay | fedapay | paydunya (vide = paiements désactivés).
PAYMENT_PROVIDER=
# Callback serveur-à-serveur optionnel (utilisée par les providers qui
# l'acceptent par facture ; sinon configurer le webhook dans le dashboard).
PAYMENT_WEBHOOK_URL=

# PawaPay (https://dashboard.pawapay.io) — token API distinct par environnement.
PAWAPAY_API_TOKEN=
# Production: https://api.pawapay.io — Sandbox: https://api.sandbox.pawapay.io
PAWAPAY_API_URL=https://api.pawapay.io
# Pays proposé au client (ISO 3166-1 alpha-3 : BEN, CIV, GHA…).
PAWAPAY_COUNTRY=BEN

# FedaPay (https://fedapay.com) — clé secrète sk_live_ / sk_demo.
FEDAPAY_SECRET_KEY=
# Live: https://api.fedapay.com/v1 — Sandbox: https://sandbox-api.fedapay.com/v1
FEDAPAY_API_URL=https://api.fedapay.com/v1

# PayDunya (https://paydunya.com) — 3 clés depuis le dashboard.
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test | live (test = /sandbox-api/, clés test_private_…)
PAYDUNYA_MODE=test

# Paiements (historique, conservé pour compat) 
PAYMENT_PROVIDER_API_KEY=
# Superadmins (emails séparés par des virgules, promus au login) —SUPERADMIN_EMAILS=
